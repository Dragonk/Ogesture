<?xml version="1.0" encoding="utf-8"?><!--
   The pre-Android-12 counterpart of data_extraction_rules.xml. android:allowBackup="false"
   already stops backup outright on these versions, so this file is belt-and-braces: it states
   the same intent — nothing in Ogesture's data directory is eligible for backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>
