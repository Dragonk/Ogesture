<?xml version="1.0" encoding="utf-8"?><!--
   Ogesture backs up nothing, as the privacy policy states. android:allowBackup="false" already
   disables cloud backup on every version, but on Android 12+ it deliberately does NOT cover
   device-to-device transfer — that route is closed here. Excluding the data directory root
   covers the only thing stored: the settings file (gestures on/off, excluded packages).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
